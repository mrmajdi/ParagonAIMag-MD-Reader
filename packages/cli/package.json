{
  "name": "paragon-reader",
  "version": "0.1.0",
  "description": "Open Markdown files in the Paragon AI MAG MD Reader from any terminal.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paragon": "./bin/paragon.js",
    "paragon-md-reader": "./bin/paragon.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
