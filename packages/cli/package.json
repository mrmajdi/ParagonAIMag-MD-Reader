    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paragon-ai-mag/server": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
